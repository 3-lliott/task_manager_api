
@baseUrl = http://127.0.0.1:8000/api/v1

### ==========================
### CATEGORIES
### ==========================

### 1. Create a category
POST {{baseUrl}}/categories
Content-Type: application/json

{
    "name": "Programming",
    "description": "Programming related tasks"
}

###

### 2. Get all categories
GET {{baseUrl}}/categories

###

### 3. Get a category by ID
GET {{baseUrl}}/categories/1

###

### 4. Create another category
POST {{baseUrl}}/categories
Content-Type: application/json

{
    "name": "Academics",
    "description": "School related tasks"
}

###

### 5. Update a category
PUT {{baseUrl}}/categories/1
Content-Type: application/json

{
    "name": "Software Development",
    "description": "Software engineering tasks"
}

###

### 6. Get tasks belonging to a category
GET {{baseUrl}}/categories/1/tasks

###

### ==========================
### TASKS
### ==========================

### 7. Create a task with a category
POST {{baseUrl}}/tasks
Content-Type: application/json

{
    "title": "Learn FastAPI",
    "description": "Understand SQLAlchemy relationships",
    "category_id": 1
}

###

### 8. Create a task without a category
POST {{baseUrl}}/tasks
Content-Type: application/json

{
    "title": "Read documentation",
    "description": "Read the FastAPI documentation"
}

###

### 9. Get all tasks
GET {{baseUrl}}/tasks

###

### 10. Get a task by ID
GET {{baseUrl}}/tasks/1

###

### 11. Update a task
PATCH {{baseUrl}}/tasks/1
Content-Type: application/json

{
    "completed": true
}

###

### 12. Change a task's category
PATCH {{baseUrl}}/tasks/1
Content-Type: application/json

{
    "category_id": 2
}

###

### 13. Remove a task's category
PATCH {{baseUrl}}/tasks/1
Content-Type: application/json

{
    "category_id": null
}

###

### 14. Delete a task
DELETE {{baseUrl}}/tasks/1

###

### 15. Delete a category
DELETE {{baseUrl}}/categories/1

###

### ==========================
### ERROR HANDLING
### ==========================

### 16. Get a nonexistent task
GET {{baseUrl}}/tasks/999

###

### 17. Get a nonexistent category
GET {{baseUrl}}/categories/999

###

### 18. Create a task with invalid category
POST {{baseUrl}}/tasks
Content-Type: application/json

{
    "title": "Invalid task",
    "description": "Testing invalid category",
    "category_id": 999
}

###

### 19. Create a category with empty name
POST {{baseUrl}}/categories
Content-Type: application/json

{
    "name": "   ",
    "description": "Invalid category"
}
