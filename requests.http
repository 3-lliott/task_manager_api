# ==================================================
# AUTHENTICATION
# ==================================================

### SIGN UP
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
    "username": "elliot",
    "password": "password123"
}

### LOGIN
POST {{baseUrl}}/auth/login
Content-Type: application/x-www-form-urlencoded

username=elliot&password=password123


# ==================================================
# TASK ENDPOINTS
# All task endpoints require authentication
# ==================================================

### CREATE TASK
POST {{baseUrl}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "Study FastAPI",
    "description": "Complete Week 5 assignment",
    "category_id": null
}

### GET ALL MY TASKS
GET {{baseUrl}}/tasks
Authorization: Bearer {{token}}

### GET ONE TASK
GET {{baseUrl}}/tasks/1
Authorization: Bearer {{token}}

### UPDATE TASK
PATCH {{baseUrl}}/tasks/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "completed": true
}

### REMOVE TASK FROM CATEGORY
PATCH {{baseUrl}}/tasks/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "category_id": null
}

### DELETE TASK
DELETE {{baseUrl}}/tasks/1
Authorization: Bearer {{token}}


# ==================================================
# CATEGORY ENDPOINTS
# ==================================================

### CREATE CATEGORY
POST {{baseUrl}}/categories
Content-Type: application/json

{
    "name": "School",
    "description": "University-related tasks"
}

### GET ALL CATEGORIES
GET {{baseUrl}}/categories

### GET ONE CATEGORY
GET {{baseUrl}}/categories/1

### UPDATE CATEGORY
PUT {{baseUrl}}/categories/1
Content-Type: application/json

{
    "name": "Programming",
    "description": "Programming and development tasks"
}

### GET TASKS IN A CATEGORY
GET {{baseUrl}}/categories/1/tasks

### DELETE CATEGORY
DELETE {{baseUrl}}/categories/1


# ==================================================
# ADMIN ENDPOINTS
# Requires an admin account
# ==================================================

### GET ALL TASKS (ADMIN ONLY)
GET {{baseUrl}}/admin/tasks
Authorization: Bearer {{token}}


# ==================================================
# AUTHENTICATION ERROR TESTS
# ==================================================

### TEST WITHOUT TOKEN (EXPECTED: 401)
GET {{baseUrl}}/tasks

### TEST WITH INVALID TOKEN (EXPECTED: 401)
GET {{baseUrl}}/tasks
Authorization: Bearer invalid_token

### TEST ADMIN ACCESS AS NORMAL USER (EXPECTED: 403)
GET {{baseUrl}}/admin/tasks
Authorization: Bearer {{token}}
